{
  "name": "@handoffkit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:studio": "node --experimental-strip-types --test src/lib/studio/parse-rankings.test.mjs src/lib/studio/ollama-models.test.mjs src/lib/studio/security-events.test.mjs src/lib/studio/browser-events.test.mjs src/lib/studio/clinical-events.test.mjs",
    "test:studio:e2e": "node scripts/studio-security-smoke.mjs",
    "a11y:audit": "node ../../scripts/js/studio-accessibility-audit.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:studio"
  },
  "dependencies": {
    "@handoffkit/browser-real": "workspace:*",
    "@handoffkit/clinical": "workspace:*",
    "@handoffkit/core": "workspace:*",
    "@handoffkit/csp": "workspace:*",
    "@handoffkit/node": "workspace:*",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "4.12.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
