{
  "name": "@handoffkit/clinical",
  "version": "1.20.0-alpha.2",
  "description": "Browser-safe Clinical Sequential Reasoning Lab contracts and HTTP client (experimental, not clinically validated).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaosPath/handoffkit.git",
    "directory": "js/packages/clinical"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./engine": {
      "types": "./src/engine.d.ts",
      "import": "./src/engine.js",
      "default": "./src/engine.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node ../../../scripts/js/check-package.mjs",
    "test": "node --test",
    "prepack": "pnpm run check && pnpm run test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/DaosPath/handoffkit#readme",
  "bugs": {
    "url": "https://github.com/DaosPath/handoffkit/issues"
  },
  "keywords": [
    "handoffkit",
    "clinical",
    "contracts",
    "snake_case"
  ],
  "sideEffects": false
}
