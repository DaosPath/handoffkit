{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeerIdentity",
  "type": "object",
  "required": [
    "peer_id",
    "node_id",
    "trust_domain"
  ],
  "properties": {
    "peer_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "worker_id": {
      "type": "string"
    },
    "trust_domain": {
      "type": "string"
    },
    "credential_fingerprint": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "integer"
    },
    "expires_at": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
