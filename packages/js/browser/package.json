{
  "name": "@handoffkit/browser",
  "version": "1.15.0",
  "description": "First-party web search, explore, scrape, and HTML→Markdown tools for HandoffKit agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaosPath/handoffkit.git",
    "directory": "packages/js/browser"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node ../../../scripts/js/check-package.mjs",
    "test": "node --test",
    "prepack": "pnpm run check && pnpm run test"
  },
  "dependencies": {
    "@handoffkit/core": "workspace:*"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/DaosPath/handoffkit#readme",
  "bugs": {
    "url": "https://github.com/DaosPath/handoffkit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "handoff",
    "web-search",
    "web-explore",
    "scrape",
    "html-to-markdown",
    "tools"
  ],
  "sideEffects": false
}
