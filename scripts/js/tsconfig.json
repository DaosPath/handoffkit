{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@handoffkit/core": ["js/packages/core/src/index.d.ts"],
      "@handoffkit/csp": ["js/packages/csp/src/index.d.ts"],
      "@handoffkit/providers": ["js/packages/providers/src/index.d.ts"],
      "@handoffkit/node": ["js/packages/node/src/index.d.ts"],
      "@handoffkit/browser": ["js/packages/browser/src/index.d.ts"],
      "@handoffkit/recipes": ["js/packages/recipes/src/index.d.ts"],
      "@handoffkit/templates": ["js/packages/templates/src/index.d.ts"],
      "@handoffkit/cli": ["js/packages/cli/src/index.d.ts"]
    }
  },
  "include": ["type-smoke.ts"]
}
