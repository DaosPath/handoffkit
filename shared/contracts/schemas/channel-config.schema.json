{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoffkit.dev/schemas/channel-config.schema.json",
  "title": "ChannelConfig",
  "type": "object",
  "required": ["name", "capacity", "overflow_policy", "requires_ack", "metadata"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "capacity": { "type": "integer", "minimum": 1 },
    "overflow_policy": { "enum": ["block", "reject"] },
    "requires_ack": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
