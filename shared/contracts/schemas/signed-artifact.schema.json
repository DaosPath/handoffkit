{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignedArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "content_hash",
    "signature",
    "algorithm",
    "signer_identity",
    "key_fingerprint",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "ed25519"
      ]
    },
    "signer_identity": {
      "type": "string"
    },
    "key_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
