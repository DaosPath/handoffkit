{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoffkit.dev/schemas/job-assignment.schema.json",
  "title": "JobAssignment",
  "type": "object",
  "required": ["assignment_id", "job_id", "worker_id", "attempt", "assigned_at", "lease_deadline", "payload", "metadata"],
