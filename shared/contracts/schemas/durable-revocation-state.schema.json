{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DurableRevocationState",
  "type": "object",
  "required": [
    "checksum",
    "entries",
    "format",
    "format_version",
    "generation"
  ],
  "properties": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/revocationEntry"
      }
    },
    "format": {
      "const": "handoffkit.security.revocations"
    },
    "format_version": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "revocationEntry": {
      "type": "object",
      "required": [
        "effective_at",
        "expires_at",
        "kind",
        "reason",
        "revoked_at",
        "value"
      ],
      "properties": {
        "effective_at": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "certificate_fingerprint",
            "signer_fingerprint",
            "peer_id",
            "issuer",
            "trust_domain"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revoked_at": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    }
  }
}
