{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityConfig",
  "type": "object",
  "required": [
    "profile"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "local",
        "standard",
        "hybrid-pq",
        "research"
      ]
    },
    "require_mtls": {
      "type": "boolean",
      "default": false
    },
    "allow_insecure_loopback": {
      "type": "boolean",
      "default": false
    },
    "trust_domain": {
      "type": "string"
    },
    "replay_window_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 300
    },
    "max_clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 10
    }
  },
  "additionalProperties": false
}
