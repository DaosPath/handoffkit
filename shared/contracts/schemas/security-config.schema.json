{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityConfig",
  "type": "object",
  "required": [
    "profile"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "local",
        "standard",
        "hybrid-pq",
        "research"
      ]
    },
    "require_mtls": {
      "type": "boolean",
      "default": false
    },
    "allow_insecure_loopback": {
      "type": "boolean",
      "default": false
    },
    "trust_domain": {
      "type": "string"
    },
    "credential_source": {
      "type": "string",
      "enum": ["file", "os_keystore"],
      "default": "file"
    },
    "credential_target": {
      "type": ["string", "null"]
    },
    "ca_cert_path": {
      "type": ["string", "null"]
    },
    "cert_path": {
      "type": ["string", "null"]
    },
    "key_path": {
      "type": ["string", "null"]
    },
    "crl_path": {
      "type": ["string", "null"]
    },
    "ocsp_response_path": {
      "type": ["string", "null"]
    },
    "ocsp_fetch": {
      "type": "boolean",
      "default": false,
      "description": "Unavailable in current runtimes; true must fail closed."
    },
    "ocsp_responder_url": {
      "type": ["string", "null"],
      "description": "Responder fetch is unavailable; retained only for structured rejection."
    },
    "require_ocsp": {
      "type": "boolean",
      "default": false
    },
    "replay_window_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 300
    },
    "max_clock_skew_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 10
    }
  },
  "additionalProperties": false
}
