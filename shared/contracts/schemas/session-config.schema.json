{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handoffkit.dev/schemas/session-config.schema.json",
  "title": "SessionConfig",
  "type": "object",
  "required": [
    "session_id",
    "runtime_mode",
    "channel_capacity",
    "max_message_bytes",
    "ack_timeout_ms",
    "dedup_capacity",
    "retry_policy",
    "metadata"
  ],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "runtime_mode": { "enum": ["classic", "session", "distributed"] },
    "channel_capacity": { "type": "integer", "minimum": 1 },
    "max_message_bytes": { "type": "integer", "minimum": 1024 },
    "ack_timeout_ms": { "type": "integer", "minimum": 1 },
    "dedup_capacity": { "type": "integer", "minimum": 1 },
    "retry_policy": {
      "type": "object",
      "required": ["max_attempts", "base_delay_ms", "max_delay_ms"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "base_delay_ms": { "type": "integer", "minimum": 0 },
        "max_delay_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "deadline": { "type": ["string", "null"], "format": "date-time" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
